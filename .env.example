# ==========================================================
#  إعدادات Firebase (اختيارية)
#  انسخ هذا الملف إلى ‎.env‎ ثم عدّل القيم.
#  إن لم تنشئ الملف فسيستخدم الموقع القيم الافتراضية المكتوبة في src/lib/firebase.ts
# ==========================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# اسم قاعدة بيانات Firestore إن كانت مُسمّاة (Named database) وليست (default)
VITE_FIREBASE_DATABASE_ID=
