{
  "entities": {
    "Car": {
      "title": "Car Listing",
      "description": "A car advertised for sale in Libya",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "maxLength": 100,
          "description": "SEO friendly unique permalink slug"
        },
        "make": {
          "type": "string",
          "maxLength": 50,
          "description": "Car brand"
        },
        "model": {
          "type": "string",
          "maxLength": 50,
          "description": "Car model"
        },
        "year": {
          "type": "number",
          "description": "Manufacturing year"
        },
        "price": {
          "type": "number",
          "description": "Price in LYD"
        },
        "city": {
          "type": "string",
          "maxLength": 50,
          "description": "City in Libya"
        },
        "mileage": {
          "type": "string",
          "maxLength": 50,
          "description": "Odometer reading or condition"
        },
        "whatsapp": {
          "type": "string",
          "maxLength": 20,
          "description": "Seller WhatsApp number"
        },
        "phone": {
          "type": "string",
          "maxLength": 20,
          "description": "Seller phone number"
        },
        "image": {
          "type": "string",
          "maxLength": 300000,
          "description": "Primary car image"
        },
        "images": {
          "type": "array",
          "description": "Gallery of car photos"
        },
        "engine": {
          "type": "string",
          "maxLength": 100,
          "description": "Engine specifications"
        },
        "transmission": {
          "type": "string",
          "maxLength": 100,
          "description": "Transmission type"
        },
        "features": {
          "type": "array",
          "description": "List of vehicle features and options"
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Car condition and details"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "description": "Creator User ID"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 100,
          "description": "Creator Name"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp created"
        },
        "views": {
          "type": "number",
          "description": "View count"
        }
      },
      "required": [
        "make",
        "model",
        "year",
        "price",
        "city",
        "whatsapp"
      ]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Registered buyer or seller profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "description": "Auth UID"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "email": {
          "type": "string",
          "maxLength": 150,
          "description": "Email address"
        },
        "phone": {
          "type": "string",
          "maxLength": 20,
          "description": "Libyan phone / WhatsApp"
        },
        "city": {
          "type": "string",
          "maxLength": 50,
          "description": "City in Libya"
        },
        "createdAt": {
          "type": "number",
          "description": "Registration timestamp"
        }
      },
      "required": [
        "uid",
        "displayName"
      ]
    }
  },
  "firestore": {
    "/cars/{carId}": {
      "schema": "Car",
      "description": "Public car marketplace listings"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profiles"
    }
  }
}
